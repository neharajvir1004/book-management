{
  "info": {
    "name": "Book Management API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Import into Postman. Start the Flask app first (python app.py). Run the 'Valid requests' folder in order, then the 'Invalid requests' folder."
  },
  "item": [
    {
      "name": "Valid requests (run these in order)",
      "item": [
        {
          "name": "1. Create book",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/books",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "books"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Python Crash Course\",\n  \"author\": \"Eric Matthes\",\n  \"category\": \"Programming\",\n  \"publication_year\": 2023,\n  \"status\": \"Available\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', function () { pm.response.to.have.status(201); });",
                  "const book = pm.response.json();",
                  "pm.collectionVariables.set('book_id', book.id);",
                  "pm.test('Default status saved', function () { pm.expect(book.status).to.eql('Available'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Get all books",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/books",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "books"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "3. Get one book",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/books/{{book_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "books",
                "{{book_id}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "4. Update book",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/books/{{book_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "books",
                "{{book_id}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Python Crash Course (3rd Edition)\",\n  \"author\": \"Eric Matthes\",\n  \"category\": \"Programming\",\n  \"publication_year\": 2023,\n  \"status\": \"Issued\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "5. Search books",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/books/search?q=python",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "books",
                "search"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "python"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "6. Filter by status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/books?status=Issued",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "books"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "Issued"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "7. Delete book",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/books/{{book_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "books",
                "{{book_id}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        }
      ]
    },
